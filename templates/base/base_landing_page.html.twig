<!DOCTYPE html>
<html>
<head>
    <title>{% block title %}MAG plus{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/landing.css') }}">
    {% endblock %}
</head>
<body>
<div class="container max-width-100">
    {% include 'components/header.html.twig' %}


    {% include 'components/banner.html.twig' %}

    <div class="action-section">
        {% block action_block %}{% endblock %}
    </div>
    <div class="price-section">
        {% block price_block %} $5.500 / Semanal {% endblock %}
    </div>

    {% include 'components/disclaimer.html.twig' %}

    {% include 'components/footer.html.twig' %}
</div>

</body>
</html>
